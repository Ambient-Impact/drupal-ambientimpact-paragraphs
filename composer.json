{
  "name": "drupal/ambientimpact_paragraphs",
  "description": "Ambient.Impact - Paragraphs",
  "type": "drupal-custom-module",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Ambient.Impact",
      "homepage": "https://ambientimpact.com/",
      "role": "Developer"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://git.drupalcode.org/issue/geshifilter-3430749.git",
      "only": ["drupal/geshifilter"]
    }
  ],
  "require": {
    "php": "^8.1",
    "cweagans/composer-patches": "^1.7.0",
    "drupal/core": "^9.5 || ^10.0 || ^11.0",
    "drupal/geshifilter": "dev-3430749-automated-drupal-11 as 3.0",
    "drupal/hux": "^1.1",
    "drupal/paragraphs": "^1.8.0",
    "symfony/css-selector": "^6.2 || ^7.3",
    "symfony/dom-crawler": "^6.2 || ^7.3"
  },
  "extra": {
    "patches": {
      "geshi/geshi": {
        "Use MDN links for HTML5 syntax highlighting": "https://raw.githubusercontent.com/Ambient-Impact/drupal-ambientimpact-paragraphs/3e6afd922863f2fd90406756a20ab25de3d09a3c/patches/geshi/geshi/html5-mdn-urls.patch"
      }
    }
  }
}
